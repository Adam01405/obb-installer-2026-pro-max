    <string name="help_title">שאלות נפוצות</string>
    <string name="help_q1">היכן משיגים את ה-APK וה-OBB?</string>
    <string name="help_a1">מגיבוי קיים שלך, או מארכיון sideload. ה-hub לא מוריד שום דבר.</string>
    <string name="help_q2">המשחק קורס בהפעלה.</string>
    <string name="help_a2">חלק קטן מהמשחקים הישנים בודקים את החתימה שלהם בקוד ומסרבים לפעול לאחר חתימה מחדש. רוב משחקי התחרות המקוונים ידחו גם הם את החתימה שתוקנה. אין פתרון לכך ברמת ה-hub.</string>
    <string name="help_q3">ההפעלה הראשונה איטית / מסך שחור.</string>
    <string name="help_a3">נורמלי. הרכיב המוזרק פורש את ה-OBB לתיקייה הפרטית של המשחק. כ-30 שניות לגיגה-בייט. ההפעלות הבאות מיידיות.</string>
    <string name="help_q4">האם זה יעודכן מ-Play Store?</string>
    <string name="help_a4">לא. חבילות שנחתמו מחדש לא ניתנות לעדכון מ-Play Store. התקן מחדש דרך ה-hub כשזמינה גרסה חדשה.</string>
    <string name="help_q5">האם משהו נשלח לאינטרנט?</string>
    <string name="help_a5">לא. הכול קורה במכשיר.</string>
