    <string name="how_it_works_title">איך זה עובד</string>
    <string name="how_it_works_body">ה-OBB משולב בתוך ה-APK. רכיב קטן ובלתי נראה המוזרק ליד המשחק מחלץ אותו בהפעלה הראשונה — ישירות מתוך התהליך של המשחק, שבו כל גרסת Android מאפשרת כתיבה לתיקיית ה-OBB. ללא הרשאות מיוחדות, ואף OEM לא יכול לחסום זאת.</string>
    <string name="caveat_title">הערה</string>
    <string name="caveat_body">המשחק נחתם מחדש עם המפתח של ה-hub, כך שעדכונים מ-Play Store אינם אפשריים עוד וכל מערכת anti-cheat מקוונת תדחה אותו. משחקים לשחקן יחיד ומשחקים לא מקוונים פועלים כרגיל.</string>
    <string name="about_title">אודות</string>
    <string name="about_intro">מתקין עצמאי למשחקי Android המופצים כ-APK + OBB.</string>
    <string name="about_features_title">מה זה עושה</string>
    <string name="about_feature_1">מתקין את ה-APK בלחיצה אחת.</string>
    <string name="about_feature_2">מטמיע את ה-OBB בתוך ה-APK כך שהמשחק מוצא אותו בכוחות עצמו.</string>
    <string name="about_feature_3">מעלה אוטומטית את targetSdk במשחקים ישנים כדי ש-Android מודרני יקבל אותם.</string>
    <string name="about_feature_4">מתקן אוטומטית ספריות native ישנות עם relocations של טקסט (libogg, libcrypto, …).</string>
    <string name="about_feature_5">מתקן אוטומטית קטעים ניתנים לכתיבה ולהרצה בספריות native שאבטחת W^X של Android 13+ דוחה.</string>
    <string name="about_compat_title">תאימות</string>
    <string name="about_compat_body">Android 11+ (Xiaomi/HyperOS, OnePlus, Samsung One UI, Pixel ועוד). 90%+ ממשחקי השחקן היחיד הישנים מותקנים ופועלים.</string>
    <string name="about_version">גרסה %1$s</string>
    <string name="about_changelog_title">יומן שינויים</string>
    <string name="about_changelog_1">v2.0 · 2026-08-28\nתמיכה ב-split APK, OBB כפול (main + patch), יישור עמודים של 16 KB, ו-7 תרגומים חדשים.</string>
    <string name="about_changelog_2">v1.1 · 2026-08-28\nקבצי OBB משתנים לשם התקני כדי שכל שם קובץ יזוהה; טעינת ספריות native תוקנה עבור Android 13+ W^X.</string>
    <string name="about_changelog_3">v1.0 · 2026-08-27\nשחרור ראשוני עם התקנת APK + OBB בלחיצה אחת.</string>
    <string name="about_dev_title">Fork &amp; קרדיטים</string>
    <string name="about_dev_author">שונה על ידי MT·xiaoyun · 2026</string>
    <string name="about_dev_repo_label">הפרויקט המקורי ב-GitHub</string>
